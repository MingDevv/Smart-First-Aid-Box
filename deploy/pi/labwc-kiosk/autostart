#!/bin/sh
# labwc session autostart for the Smart First Aid Box cabinet kiosk.
#
# STATUS: NEVER APPLIED. Not observed running on hardware.
# Install: /home/technology/.config/labwc/autostart   (technology:technology 0755)
#
# WHAT REPLACING THIS FILE REMOVES
# Raspberry Pi OS ships its own autostart here, and it is what draws the desktop. On a
# stock Pi OS labwc session it starts roughly:
#     wf-panel-pi            the taskbar / menu bar          -> gone
#     pcmanfm --desktop      desktop icons and wallpaper     -> gone
#     lxpolkit, lxsession-ish helpers, notification daemon   -> gone
# VERIFY the exact contents of the file you are replacing by reading the backup you took
# in step 0 of ../README.md. Do not assume this list matches your image; Pi OS changes
# it between releases, and anything in it that you still need (for example a display
# power helper) has to be carried across by hand.

# Hand the session's Wayland environment to the systemd user manager. Without this the
# user units below start with no WAYLAND_DISPLAY and Chromium exits immediately with
# "Unable to open display" or an ozone platform error.
# XDG_CURRENT_DESKTOP is imported too because some toolkits key portal behaviour off it.
systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP

# Start the kiosk. This unit's ExecStartPre waits for the edge service to answer, so
# there is no ordering problem here even though the edge service is a system unit and
# this is a user unit — see sfab-kiosk.service for why that split forces a polling wait.
systemctl --user start sfab-kiosk.service

# ── Optional, decide per device ──────────────────────────────────────────────
#
# Blank background while the kiosk waits for the edge service. Without something here,
# boot shows the bare compositor for as long as sfab-wait-for-edge.sh takes (up to ~60s
# in the worst case), which reads to a bystander as "the cabinet is broken". Requires
# swaybg to be installed; left commented because installing a package is a decision.
#swaybg -c "#0b3b2e" &
#
# SCREEN BLANKING is NOT handled here. A cabinet whose screen has blanked looks dead,
# and a resistive panel needs a tap to wake — which a student will read as the cabinet
# ignoring them. Turn blanking off through `sudo raspi-config` -> Display Options ->
# Screen Blanking, then confirm by leaving the cabinet untouched for longer than the
# previous blank timeout. Do not assume it is off because you never saw it blank during
# a working session.
