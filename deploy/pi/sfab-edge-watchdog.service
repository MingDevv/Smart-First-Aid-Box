# Smart First Aid Box — liveness watchdog for the edge service.
#
# STATUS: written from source, NEVER APPLIED AND NEVER STARTED ON HARDWARE.
#         See deploy/pi/README.md.
#
# Install: /etc/systemd/system/sfab-edge-watchdog.service
# Fired by: sfab-edge-watchdog.timer  (this unit is NOT enabled directly)
#
# WHAT THIS IS FOR, IN ONE LINE
# `Restart=on-failure` on sfab-edge.service recovers a process that EXITS. This recovers
# a process that is ALIVE AND HUNG. Those are different failures and only one of them was
# covered before.
#
# WHY NOT systemd's OWN WatchdogSec=
# WatchdogSec= is the better mechanism — it is in-process, so it notices a wedged event
# loop without any network round trip. It requires the service to call
# sd_notify(WATCHDOG=1) on a timer from inside edge/server.mjs (and Type=notify), and
# edge/server.mjs is out of scope for this directory. If that is ever added, delete this
# unit and its timer: they are a workaround for its absence, not a complement to it.
#
# LIMITS — read deploy/pi/bin/sfab-edge-healthcheck.sh before trusting this. Short
# version: it proves an HTTP GET completed, nothing more. A dead ESP32 probes green, and
# a frozen Chromium is not watched by anything here at all.

[Unit]
Description=Smart First Aid Box edge service liveness probe
Documentation=file:///opt/smart-first-aid-box/deploy/pi/README.md

# The probe is meaningless if the service is not meant to be running; the script also
# checks `systemctl is-active` itself and exits 0 early in that case.
After=sfab-edge.service

[Service]
Type=oneshot

# Runs as root: it must be able to `systemctl restart sfab-edge.service`. The script is
# root-owned 0755 and takes no input from the network beyond the body of a loopback
# response, which it only string-matches — it never evaluates it.
ExecStart=/usr/local/lib/sfab/sfab-edge-healthcheck.sh

# Hard ceiling. The probe's own budget is 5s (SFAB_WATCHDOG_TIMEOUT); if the whole unit
# somehow outlives 30s it must not overlap the next timer firing.
TimeoutStartSec=30

# Modest hardening. Deliberately NOT the strict set used on sfab-edge.service: this unit
# needs to talk to the systemd private socket to issue the restart, so ProtectSystem=strict
# plus a narrow RestrictAddressFamilies would break exactly the action it exists to take.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

SyslogIdentifier=sfab-edge-watchdog
