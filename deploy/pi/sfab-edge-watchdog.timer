# Smart First Aid Box — schedule for the edge service liveness probe.
#
# STATUS: written from source, NEVER APPLIED AND NEVER STARTED ON HARDWARE.
#
# Install: /etc/systemd/system/sfab-edge-watchdog.timer
# Enable:  sudo systemctl enable --now sfab-edge-watchdog.timer
#          (enable the TIMER, never the .service — the service is a oneshot it fires)
#
# TIMING, AND WHY IT IS NOT FASTER
# 30s interval x 3 consecutive strikes => a hang is acted on after roughly 60-90s. That
# is deliberately unhurried. A restart costs a lost in-flight command and, with it, an
# 'uncertain' journal row that takes the cabinet out of service until an operator clears
# it over SSH (edge/resolve.mjs). Reacting to one slow response would trade a problem
# that might not exist for one that certainly does.
#
# WORST-CASE RECOVERY, stated plainly rather than implied:
#     up to 90s   to decide the service is hung (3 strikes)
#   + up to 150s  for the restart, because SIGTERM is tried first and TimeoutStopSec on
#                 sfab-edge.service is 150s before systemd escalates to SIGKILL
#   = up to ~4 minutes of dark cabinet in the worst case.
# The two numbers pull against each other: a longer stop budget protects a real in-flight
# dispense, and slows recovery from a wedge. 150s/90s is the chosen point, not a default.
#
# INTERACTION WITH THE START LIMIT, which can bite: every restart this issues counts
# toward StartLimitBurst=5 / StartLimitIntervalSec=300 on sfab-edge.service. A fault that
# re-wedges immediately will therefore park the unit in `failed` after a few rounds
# instead of flapping forever. That is containment working as intended — but it means a
# dark cabinet until someone runs `systemctl reset-failed sfab-edge.service`. Do not
# shorten the interval without re-checking that arithmetic.

[Unit]
Description=Run the Smart First Aid Box edge liveness probe every 30s
Documentation=file:///opt/smart-first-aid-box/deploy/pi/README.md

[Timer]
# Not OnBootSec=0: at boot the service is still starting, and sfab-wait-for-edge.sh
# already allows up to ~60s for it to answer. Probing before then would bank strikes
# against a service that is merely slow to come up.
OnBootSec=120
OnUnitActiveSec=30
AccuracySec=5

# Do not stack a second probe if one is somehow still running.
Unit=sfab-edge-watchdog.service

[Install]
WantedBy=timers.target
