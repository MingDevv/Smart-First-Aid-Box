# Server-only deployment configuration. Placeholders only; never commit real values.
# WP1 is emulator-only. Local instructions: docs/FIREBASE_SETUP.md.

# Firebase Admin (Vercel). Client email and PEM must be Sensitive env variables.
FIREBASE_PROJECT_ID=your_school_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="your_service_account_pem_with_escaped_newlines"

# Public Firebase web configuration, returned by /api/firebase-config.
FIREBASE_WEB_API_KEY=your_public_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_APP_ID=your_public_firebase_app_id

# Existing AI server key.
GEMINI_API_KEY=your_gemini_api_key_here

# Cloud SOS sends only to this target; both values are required, no broadcast fallback.
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_GROUP_ID=your_target_group_id_or_user_id_here
# Existing local cabinet integrations may use these legacy values.
LINE_NOTIFY_TOKEN=your_line_notify_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Server-only cabinet MQTT publisher. Browser configuration has been removed.
MQTT_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=vercel-publisher
MQTT_PASSWORD=your_publisher_password_here
MQTT_BASE_TOPIC=crms6/firstaidbox/box1

# No Cloud Storage, billing, TTL provisioning, or cron secret is needed for WP1.
# Never set emulator hosts or SFAB_USE_FIREBASE_EMULATORS on Vercel.
