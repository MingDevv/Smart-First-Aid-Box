# -----------------------------------------------------------------------------
# Smart First Aid Box — Environment Variables Configuration
# Copy this file to .env or configure directly in Vercel Project Settings
# -----------------------------------------------------------------------------

# 1. Google Gemini API Key (Required for AI Wound Vision Analysis)
# Get key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. LINE Notify Token (Option A: Direct group/chat notification via LINE Notify)
# Get token from LINE Notify: https://notify-bot.line.me/
LINE_NOTIFY_TOKEN=your_line_notify_token_here

# 3. LINE Messaging API Config (Option B: Push message / Broadcast via Official Account Bot)
# Get credentials from LINE Developers Console: https://developers.line.biz/
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_GROUP_ID=your_target_group_id_or_user_id_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# 4. MQTT Broker (สั่งงานตู้ยาแบบเรียลไทม์ — ดูขั้นตอนใน MQTT_SETUP.md)
# ชุดนี้เป็นรหัสที่ "publish ได้" ห้ามเอาไปใส่ในหน้าเว็บเด็ดขาด
# หน้าเว็บใช้อีกชุดหนึ่งที่ subscribe ได้อย่างเดียว ตั้งค่าในหน้าจัดการเวชภัณฑ์
MQTT_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=vercel-publisher
MQTT_PASSWORD=your_publisher_password_here
# ต้องตรงกับ BASE_TOPIC ในเฟิร์มแวร์ ESP32 และ mqttBaseTopic ในหน้าตั้งค่า
MQTT_BASE_TOPIC=crms6/firstaidbox/box1
